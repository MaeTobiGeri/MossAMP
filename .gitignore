*.apk
*.aab
*.AppImage
*.deb
*.rpm
*.dmg
*.msi

# Signing keys and secrets — never commit these
*.jks
*.keystore
key.properties
keystore.properties
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

